# Copy this file to `.env` and fill in real values. `.env` is git-ignored.

# One of: development, test, production
ENVIRONMENT=development

# Postgres credentials, used by the `db` service in docker-compose.yml.
POSTGRES_USER=rackmind
POSTGRES_PASSWORD=change-me
POSTGRES_DB=rackmind

# Async SQLAlchemy URL (note the `+asyncpg` driver part), used when running the API
# outside Docker. Inside Docker Compose this is overridden to point at the `db` service.
DATABASE_URL=postgresql+asyncpg://rackmind:change-me@localhost:5432/rackmind

# Redis is used for the job queue and pub/sub.
REDIS_URL=redis://localhost:6379/0

# Password given to the 3 demo users created by the seed script (one per role).
SEED_PASSWORD=change-me

# Simulation-mode fault schedule: comma-separated kind:target:start_s:duration_s.
# Kinds: overheat (target = rack name), cpu_spike, disk_fill and memory_leak (target = hostname).
# Times are seconds after someone switches to Simulation mode. Unset = the demo scenario in
# docker-compose.yml (an incident within about a minute).
# SIM_FAULTS=overheat:R02:60:600,memory_leak:r03-srv02:30:900

# Signs login tokens (JWT). At least 32 random characters, e.g. `openssl rand -hex 32`.
JWT_SECRET=change-me-to-a-long-random-string-of-32-chars-or-more

# Shared secret the simulator sends (X-API-Key header) to push metrics. At least 16 characters.
INGEST_API_KEY=change-me-to-a-random-key

# Optional: login session length in minutes (default 480), and HTTPS-only cookies.
# COOKIE_SECURE defaults to false in docker-compose.yml (http://localhost) and to true in
# docker-compose.prod.yml (served over HTTPS by Caddy).
# SESSION_MINUTES=480
# COOKIE_SECURE=false

# Production only (docker-compose.prod.yml): the domain Caddy serves and gets an HTTPS
# certificate for. Its DNS A record must point at the server. Defaults to localhost.
# DOMAIN=rackmind.example.com

# AI diagnosis (Groq). Get a key at https://console.groq.com/keys. Leave empty to turn AI off.
GROQ_API_KEY=
# A model that supports strict structured outputs (see https://console.groq.com/docs/structured-outputs).
GROQ_MODEL=openai/gpt-oss-120b

# A real server (agent) with no reading for this many seconds gets a "not reporting" incident.
# HEARTBEAT_TIMEOUT_S=60
