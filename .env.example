# Copy this file to `.env` and fill in real values. `.env` is git-ignored.

# One of: development, test, production
ENVIRONMENT=development

# Async SQLAlchemy URL (note the `+asyncpg` driver part).
# Inside Docker Compose the host will be the service name (e.g. `db`) instead of localhost.
DATABASE_URL=postgresql+asyncpg://rackmind:change-me@localhost:5432/rackmind

# Redis is used for the job queue and pub/sub.
REDIS_URL=redis://localhost:6379/0
