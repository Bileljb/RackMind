# Copy this file to `.env` and fill in real values. `.env` is git-ignored.

# One of: development, test, production
ENVIRONMENT=development

# Postgres credentials, used by the `db` service in docker-compose.yml.
POSTGRES_USER=rackmind
POSTGRES_PASSWORD=change-me
POSTGRES_DB=rackmind

# Async SQLAlchemy URL (note the `+asyncpg` driver part), used when running the API
# outside Docker. Inside Docker Compose this is overridden to point at the `db` service.
DATABASE_URL=postgresql+asyncpg://rackmind:change-me@localhost:5432/rackmind

# Redis is used for the job queue and pub/sub.
REDIS_URL=redis://localhost:6379/0

# Password given to the 3 demo users created by the seed script (one per role).
SEED_PASSWORD=change-me

# Simulator fault schedule: comma-separated kind:target:start_s:duration_s.
# Kinds: overheat (target = rack name), disk_fill and memory_leak (target = hostname).
# Times are seconds after the simulator starts. Leave empty for normal readings only.
SIM_FAULTS=overheat:R02:60:600,memory_leak:r03-srv02:30:900,disk_fill:r01-srv03:120:900
